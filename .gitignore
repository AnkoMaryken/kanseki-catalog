# 工作区内部数据（记忆/截图/构建中间产物）
.workbuddy/

# 系统与编辑器
.DS_Store
Thumbs.db
*.log

# 调试临时脚本
debug_*.js

# app 依赖与临时调试
app/node_modules/
app/.tmp/

# 探针脚本产出的诊断截图（仅本地取证，不入库）
app/.shot_*.png
app/*.log
# 安装包工具
app/tools/

# 管理员配置（含邮箱, 不入库）
admin-config.js

# 桌面版历史可执行文件备份（每个 13MB，不入库）
app/.backup/

# 发布包产物（安装包/免安装版/压缩包，体积大，由 scripts/make_release.mjs 生成）
release/
