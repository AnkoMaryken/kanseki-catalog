{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "古代史及汉籍研究工具",
  "version": "0.7.0",
  "identifier": "cn.kanseki.catalog",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "node scripts/build.mjs",
    "devUrl": "http://localhost:8766",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "古代史及汉籍研究工具",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
